<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2196F3">


    <ImageButton
        android:id="@+id/image_cat1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/cat"
        android:contentDescription="@string/cat1"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <ImageButton
        android:id="@+id/image_pen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/pen"
        android:contentDescription="@string/pen"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ImageButton
        android:id="@+id/image_caw"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/caw"
        android:contentDescription="@string/caw"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toBottomOf="@id/image_cat1"
        app:layout_constraintStart_toStartOf="parent" />


    <ImageButton
        android:id="@+id/image_lion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/lion"
        android:contentDescription="@string/lion"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toBottomOf="@id/image_pen"
        app:layout_constraintEnd_toEndOf="parent" />


    <ImageButton
        android:id="@+id/image_puppy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/puppy"
        android:contentDescription="@string/puppy"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toBottomOf="@id/image_caw"
        app:layout_constraintStart_toStartOf="parent" />


    <ImageButton
        android:id="@+id/image_barashek"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:src="@drawable/barashek"
        android:contentDescription="@string/barashek"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintTop_toBottomOf="@id/image_lion"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>